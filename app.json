{
  "expo": {
    "name": "KiToc",
    "slug": "KiToc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/toctoc-icon.png",
    "scheme": "kitoc",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.AssmatApp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/toctoc-icon.png",
        "backgroundImage": "./assets/images/toctoc-icon.png",
        "monochromeImage": "./assets/images/toctoc-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.AssmatApp",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/toctoc-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      [
        "expo-audio",
        {
          "microphonePermission": "Toctoc a besoin d'accéder au micro pour enregistrer un message vocal."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "32d2e958-9d7f-45b5-9179-49e2da6c9782"
      }
    },
    "owner": "eyzen1234"
  }
}
