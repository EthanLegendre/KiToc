{
  "expo": {
    "name": "KiToc",
    "slug": "KiToc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/toctoc-icon.png",
    "scheme": "KiToc",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.AssmatApp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/toctoc-icon.png",
        "backgroundImage": "./assets/images/toctoc-icon.png",
        "monochromeImage": "./assets/images/toctoc-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.AssmatApp"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/toctoc-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      [
        "expo-audio",
        {
          "microphonePermission": "Toctoc a besoin d'accéder au micro pour enregistrer un message vocal."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
